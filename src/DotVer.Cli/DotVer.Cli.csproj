<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DotVer.Infrastructure\DotVer.Infrastructure.csproj" />
    <ProjectReference Include="..\DotVer.Application\DotVer.Application.csproj" />
    <ProjectReference Include="..\DotVer.Domain\DotVer.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.49.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>dotver</AssemblyName>
    <PackageId>dotver</PackageId>
    <Description>Cross-platform .NET SDK version manager with Spectre.Console TUI and dotnet shims.</Description>
    <!-- NuGet ships the same CLI as a framework-dependent global tool: dotnet tool install -g dotver -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotver</ToolCommandName>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
